# ==============================================================================
# Mini LLM Backend Environment Configuration
# ==============================================================================

# Server Network Settings
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development

# Allowed CORS Origins (comma-separated URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Model Checkpoint Filepaths (Absolute or relative to project root)
MODEL_25K_CHECKPOINT=../mini-llm-lab/artifacts/experiments/tiny_25k_baseline_b288_v1/checkpoints/best.pt
MODEL_100K_CHECKPOINT=../mini-llm-lab/artifacts/experiments/tiny_100k_b1280_v1/checkpoints/best.pt

# Device Selection: "auto", "cuda", or "cpu"
DEVICE=auto

# Text Generation Constraints and Defaults
MAX_ALLOWED_TOKENS=5000
DEFAULT_MAX_TOKENS=200
DEFAULT_TEMPERATURE=0.8
DEFAULT_TOP_K=20
DEFAULT_TOP_P=0.9
