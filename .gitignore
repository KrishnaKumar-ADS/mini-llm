# ==============================================================================
# Mini LLM Lab .gitignore
# ==============================================================================

# Python environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / cache / test artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.coverage.*

# Python packaging & build artifacts
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Node / Frontend
node_modules/
.npm/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files and secrets
.env
.env.*
!.env.example
*.env.local

# Editor & OS files
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# ==============================================================================
# Datasets & Training Data - Completely excluded from git (no dataset files in repo)
# ==============================================================================
data/
data/*
data/**
*.parquet
*.arrow
*.tar.gz
*.zip
*.bin

# ==============================================================================
# Experiment Checkpoints & Artifacts
# ==============================================================================
artifacts/*

# Keep selected experiment directories
!artifacts/experiments/
artifacts/experiments/*
!artifacts/experiments/tiny_25k_baseline_b288_v1/
!artifacts/experiments/tiny_100k_b1280_v1/

# Keep only best.pt in the selected checkpoints directories
artifacts/experiments/tiny_25k_baseline_b288_v1/*
artifacts/experiments/tiny_100k_b1280_v1/*
!artifacts/experiments/tiny_25k_baseline_b288_v1/checkpoints/
!artifacts/experiments/tiny_100k_b1280_v1/checkpoints/

artifacts/experiments/tiny_25k_baseline_b288_v1/checkpoints/*
artifacts/experiments/tiny_100k_b1280_v1/checkpoints/*
!artifacts/experiments/tiny_25k_baseline_b288_v1/checkpoints/best.pt
!artifacts/experiments/tiny_100k_b1280_v1/checkpoints/best.pt

# Ignore all other .pt checkpoint files anywhere
*.pt
!artifacts/experiments/tiny_25k_baseline_b288_v1/checkpoints/best.pt
!artifacts/experiments/tiny_100k_b1280_v1/checkpoints/best.pt

# Detailed experiment logs that can be regenerated
reports/experiments/
reports/training_metrics.jsonl
